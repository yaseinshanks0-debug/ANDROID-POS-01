{
  "appId": "com.dqnamo.pos",
  "productName": "D POS - Point of Sale",
  "electronVersion": "33.4.0",
  "extraMetadata": {
    "name": "dqnamo-pos",
    "version": "2.5.0",
    "main": "electron/main.cjs",
    "description": "D POS - Point of Sale & Live Wi-Fi LAN Sync"
  },
  "directories": {
    "output": "release-exe"
  },
  "npmRebuild": false,
  "asar": false,
  "files": [
    "dist/**/*",
    "dist-server/**/*",
    "electron/**/*",
    "package.json",
    "!node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "dist",
      "to": "www",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": ".data",
      "to": "seed-data",
      "filter": [
        "*.json"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "D POS - Point of Sale",
    "artifactName": "D-POS-Setup.exe"
  },
  "portable": {
    "artifactName": "D-POS-Portable.exe"
  }
}
