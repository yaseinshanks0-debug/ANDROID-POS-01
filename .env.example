# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Cloud SQL (PostgreSQL) Runtime Variables
# Automatically provisioned and injected by Google Cloud SQL Auth Proxy in AI Studio
SQL_HOST="/app/cloudsql/project:region:instance"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="ai_studio_app_user"
SQL_PASSWORD="AUTO_GENERATED_PASSWORD"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="AUTO_GENERATED_ADMIN_PASSWORD"

# External PostgreSQL Connection (Optional fallback if not using Cloud SQL)
# Option A: Full Connection URI (Neon / Supabase)
DATABASE_URL="postgres://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Option B: Discrete Parameters
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="password"
PGDATABASE="pos_db"
PGSSLMODE="prefer"
